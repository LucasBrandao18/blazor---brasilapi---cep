@page "/"

@using System.Net
@using System.Text.Json
@using System.Text.RegularExpressions
@using BlazorWasmBrasilApiCep.Models
@inject HttpClient Http
@implements IDisposable

<PageTitle>Consulta CEP · BrasilAPI</PageTitle>

<h1>Consulta de CEP com Blazor WebAssembly</h1>
<p>Encontre um endereço usando a BrasilAPI.</p>

<form @onsubmit="ConsultarCep" @onsubmit:preventDefault novalidate class="consulta">
    <label for="cep" class="form-label">Digite o CEP</label>
    <div class="d-flex gap-2 flex-wrap">
        <input id="cep" class="form-control campo-cep" type="text" inputmode="numeric"
               autocomplete="postal-code" placeholder="Ex.: 30130-000" aria-describedby="cepAjuda"
               @bind="cepDigitado" @bind:event="oninput" disabled="@carregando" />
        <button type="submit" class="btn btn-primary" disabled="@carregando">
            @(carregando ? "Buscando..." : "Consultar")
        </button>
    </div>
    <p id="cepAjuda" class="form-text">Informe 8 números, com ou sem hífen.</p>
</form>

@if (carregando)
{
    <p role="status" class="mt-3">Consultando o endereço. Aguarde...</p>
}
@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div role="alert" class="alert alert-danger mt-3 consulta">@mensagemErro</div>
}
@if (endereco is not null)
{
    <section class="card mt-4 consulta" aria-labelledby="tituloEndereco" aria-live="polite">
        <div class="card-body">
            <h2 id="tituloEndereco" class="h4 text-success">Endereço encontrado</h2>
            <dl>
                <dt>CEP</dt><dd>@endereco.Codigo</dd>
                <dt>Logradouro</dt><dd>@Exibir(endereco.Logradouro)</dd>
                <dt>Bairro</dt><dd>@Exibir(endereco.Bairro)</dd>
                <dt>Cidade</dt><dd>@endereco.Cidade (@endereco.Estado)</dd>
                <dt>Serviço</dt><dd>@Exibir(endereco.Servico)</dd>
            </dl>
            <hr />
            <h3 class="h5">Dados do IBGE</h3>
            <dl class="mb-0">
                <dt>Cidade IBGE</dt><dd>@Exibir(endereco.Ibge?.Cidade)</dd>
                <dt>Estado IBGE</dt><dd class="mb-0">@Exibir(endereco.Ibge?.Estado)</dd>
            </dl>
        </div>
    </section>
}

@code {
    private string cepDigitado = string.Empty;
    private string mensagemErro = string.Empty;
    private bool carregando;
    private Cep? endereco;
    private readonly CancellationTokenSource cancelamento = new();

    private async Task ConsultarCep()
    {
        if (carregando)
        {
            return;
        }

        endereco = null;
        mensagemErro = string.Empty;
        var entrada = cepDigitado.Trim();
        // Aceita apenas os dois formatos de CEP, preservando zeros à esquerda.
        if (!Regex.IsMatch(entrada, @"\A[0-9]{5}-?[0-9]{3}\z"))
        {
            mensagemErro = "Digite um CEP válido com 8 números, como 30130000 ou 30130-000.";
            return;
        }

        var cep = entrada.Replace("-", string.Empty);
        carregando = true;
        try
        {
            using var resposta = await Http.GetAsync($"api/cep/v1/{cep}", cancelamento.Token);
            if (resposta.StatusCode == HttpStatusCode.NotFound)
            {
                mensagemErro = "CEP não encontrado. Confira os números e tente novamente.";
                return;
            }
            if (resposta.StatusCode == HttpStatusCode.BadRequest)
            {
                mensagemErro = "A API recusou o CEP informado. Confira os números.";
                return;
            }
            if (!resposta.IsSuccessStatusCode)
            {
                mensagemErro = "A BrasilAPI está indisponível no momento. Tente novamente mais tarde.";
                return;
            }

            var resultado = await resposta.Content.ReadFromJsonAsync<Cep>(cancellationToken: cancelamento.Token);
            if (resultado is null || resultado.Codigo != cep ||
                string.IsNullOrWhiteSpace(resultado.Cidade) || string.IsNullOrWhiteSpace(resultado.Estado))
            {
                mensagemErro = "A API retornou dados incompletos ou diferentes do CEP consultado. Tente novamente.";
                return;
            }

            endereco = resultado;
        }
        catch (OperationCanceledException) when (cancelamento.IsCancellationRequested)
        {
            // O componente foi encerrado: a consulta pendente foi cancelada.
        }
        catch (OperationCanceledException)
        {
            mensagemErro = "A consulta demorou demais. Tente novamente em alguns instantes.";
        }
        catch (HttpRequestException)
        {
            mensagemErro = "Não foi possível acessar a BrasilAPI. Verifique sua conexão e tente novamente.";
        }
        catch (JsonException)
        {
            mensagemErro = "A API retornou uma resposta em formato inválido. Tente novamente.";
        }
        finally
        {
            carregando = false;
        }
    }

    private static string Exibir(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "Não informado pela API" : valor;

    public void Dispose()
    {
        cancelamento.Cancel();
        cancelamento.Dispose();
    }
}
